# qmesh fly smoke test: two machines (sea + mia), throwaway app.
# Per-machine env (QMESH_*) is applied via `fly machine update` after
# each machine's private 6pn IP is known — see tools/fly-smoke.md.
app = "qmesh-smoke-nullstyle"
primary_region = "sjc"

[[vm]]
  size = "shared-cpu-1x"
  memory = "256mb"

